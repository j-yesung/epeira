{
  "name": "tycho-app",
  "productName": "Tycho",
  "version": "0.6.1",
  "private": true,
  "description": "프로젝트 사이드바 + 에이전트 터미널 + 궤도 시각화",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.tycho.app",
    "productName": "Tycho",
    "copyright": "Tycho",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "assets/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {"from": "../agent_orbit.py", "to": "collector/agent_orbit.py"},
      {"from": "../index.html", "to": "collector/index.html"},
      {"from": "../app.js", "to": "collector/app.js"},
      {"from": "../install.sh", "to": "collector/install.sh"}
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Tycho"
      }
    },
    "dmg": {
      "title": "Tycho",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
