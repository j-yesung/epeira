{
  "name": "epeira-app",
  "productName": "Epeira",
  "version": "1.3.0",
  "private": true,
  "description": "프로젝트 사이드바 + 에이전트 터미널 + 궤도 시각화",
  "license": "MIT",
  "author": "Yesung Jang",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "prepare": "cd .. && lefthook install || true",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "fsd": "steiger ./src/renderer/src",
    "test": "electron-vite build && node --test --test-timeout=120000 test/*.test.mjs",
    "dist": "electron-vite build && mkdir -p dist && touch dist/.metadata_never_index && electron-builder --mac dmg --arm64 --x64",
    "sign": "node sign.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron/rebuild": "^4.2.1",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "i18next": "^26.4.6",
    "lefthook": "^2.2.2",
    "lucide-react": "^1.57.0",
    "playwright-core": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.18",
    "react-resizable-panels": "^4.14.5",
    "sonner": "^2.0.8",
    "steiger": "^0.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "dev.epeira.app",
    "productName": "Epeira",
    "copyright": "Epeira",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "../agent_orbit.py",
        "to": "collector/agent_orbit.py"
      },
      {
        "from": "../index.html",
        "to": "collector/index.html"
      },
      {
        "from": "../app.js",
        "to": "collector/app.js"
      },
      {
        "from": "../install.sh",
        "to": "collector/install.sh"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Epeira"
      }
    },
    "dmg": {
      "title": "Epeira",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  }
}
