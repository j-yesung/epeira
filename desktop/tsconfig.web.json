{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@ipc/*": ["./src/ipc/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["src/renderer/src/**/*", "src/ipc/**/*"]
}
